# ==============================================================================
# SPARQ CONNECTION LAB - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to `.env.local`
# 2. Fill in the values for the API keys matching your environment
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. SUPABASE (Database, Auth, Storage)
# Get these project settings from your Supabase Dashboard
# ──────────────────────────────────────────────────────────────────────────────
# The URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# The public anon key for browser clients
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# The secret service role key (NEVER expose this to the browser!)
# Used for backend administrative tasks like Server-side Memory Management
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ──────────────────────────────────────────────────────────────────────────────
# 2. AI MODEL PROVIDERS (Peter AI, Context generation, Voice processing)
# ──────────────────────────────────────────────────────────────────────────────
# OpenAI API Key (Used for Whisper Voice Transcription & LLM Moderation Filters)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (Used to route standard Peter AI Chat prompts to specific models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Public Google key for client-side places/date helpers
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key_here

# ──────────────────────────────────────────────────────────────────────────────
# 3. LOCAL BETA TESTING
# ──────────────────────────────────────────────────────────────────────────────
# Optional seeded login for Playwright or manual beta checks
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=changeme123

# Optional controlled-beta cutoff for the playful layer.
# When set, only users created on or before this UTC timestamp will receive
# Daily Spark and Favorite Us. Leave blank to expose the playful layer to all
# authenticated users.
PLAYFUL_BETA_COHORT_CUTOFF=

# ──────────────────────────────────────────────────────────────────────────────
# 4. MEMORY & EXTERNAL SERVICES
# ──────────────────────────────────────────────────────────────────────────────
# Supabase Vector DB will be used for long-term Peter memory (pgvector)
# No additional keys needed — uses SUPABASE_SERVICE_ROLE_KEY above

# ──────────────────────────────────────────────────────────────────────────────
# 5. DAILY REMINDERS — phone + email (built, not switched on; docs/REMINDERS.md)
# ──────────────────────────────────────────────────────────────────────────────
# Phone notifications are free: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # shows the phone switch in Settings
VAPID_PRIVATE_KEY=              # secret
VAPID_SUBJECT=                  # mailto:you@yourdomain.com
# Email: while RESEND_API_KEY is blank, email is a dry run.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
REMINDER_SIGNING_SECRET=        # openssl rand -hex 32 (signs unsubscribe links)
CRON_SECRET=                    # openssl rand -hex 32 (protects /api/cron/reminders)
NEXT_PUBLIC_APP_URL=            # e.g. https://yourdomain.com
NEXT_PUBLIC_EMAIL_REMINDERS_ENABLED=  # "true" shows the email switch in Settings
